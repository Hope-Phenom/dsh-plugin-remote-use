# ---------------------------------------------------------------------------
# 依赖
# ---------------------------------------------------------------------------
node_modules/

# ---------------------------------------------------------------------------
# DSH asar 解包副本 —— 专有代码，绝不入库
#
# `.research/asar/` 是对 DeepSeek Harness 打包产物的逐字节解包（97.9 MB），
# `.research/asar-root/` 是其中的 host 壳层。它们只用于本地源码级调研，
# 属于第三方专有代码，提交进仓库既无必要也不合适。
# `.research/sdk/` 是 ACP SDK 的 vendored 副本（同样可由依赖获得）。
# ---------------------------------------------------------------------------
.research/asar/
.research/asar-root/
.research/sdk/

# ---------------------------------------------------------------------------
# 编译 / 构建产物
#
# `.research/stage/` 是 Avalonia 测试应用的 .NET 输出（30.7 MB of DLL/exe）。
# ---------------------------------------------------------------------------
.research/stage/
bin/
obj/
dist/
*.dll
*.exe
*.pdb
*.so
*.dylib

# ---------------------------------------------------------------------------
# 运行期生成物
#
# 自检脚本把报告写到自身旁边（$PSScriptRoot），所以本地跑一次就会留下这两个文件。
# ---------------------------------------------------------------------------
*.log
selfcheck.json
selfcheck.txt

# ---------------------------------------------------------------------------
# 测试夹具与临时目录（备份/还原工具的自测会创建）
# ---------------------------------------------------------------------------
.test-fixture*/
.tf3/
.jtest/

# 还原工具的还原前自动快照
*.pre-restore-*/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ---------------------------------------------------------------------------
# 编辑器 / 系统
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store

# ---------------------------------------------------------------------------
# 安装过程快照与本地密钥（含从机中继 token，绝不入库）
# ---------------------------------------------------------------------------
.install-snapshot/

# 截图证据（体积大且含桌面内容，按需单独保管）
#
# NOTE：这条只匹配 `.research/` 根目录那一层。`slave-shots/` 与 `vdd-shots/` 里那 4 张是
# `docs/research/08-gui-mechanism-actual.md` 的证据图（文档按字节数引用了它们），**已逐张核对
# 过不含隐私**（都只是那个测试应用自己的窗口，没有桌面/任务栏/用户名），所以它们是有意入库的。
# 新截图请放根目录（会被忽略），或确认过内容再放进这两个子目录。
.research/*.png
.research/slave-config/

# The worker self-check writes its report next to the script. It is a GENERATED artifact that
# names the machine it ran on, and `package.json` ships `slave/` -- so a stale report would travel
# inside the plugin and a worker could serve another machine's readiness. Regenerated on every run.
packages/dsh-plugin-remote-use/slave/selfcheck.json
packages/dsh-plugin-remote-use/slave/selfcheck.txt
packages/dsh-plugin-remote-use/slave/shots/
packages/dsh-plugin-remote-use/slave/pairing.txt
packages/dsh-plugin-remote-use/slave/screenshot-report.txt
# Contains the literal values being scrubbed -- committing it would undo the scrub.
.research/privacy-replacements.txt
