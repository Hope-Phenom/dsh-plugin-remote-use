# 统一换行符，避免 Windows 上全仓 diff 抖动。
# 仓库内存 LF，工作区按平台签出。
* text=auto eol=lf

# PowerShell 脚本保持 LF；自检脚本必须是纯 ASCII 且不含 BOM
# （Windows PowerShell 5.1 会把无 BOM 文件当 ANSI 读，非 ASCII 字节会直接破坏解析）
*.ps1 text eol=lf
*.psm1 text eol=lf

# Windows 专用文本文件
*.cmd text eol=crlf
*.bat text eol=crlf

# 二进制——不做任何转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.dll binary
*.exe binary
*.so binary
*.dylib binary
*.woff binary
*.woff2 binary

# 锁文件不参与 diff 统计（减少噪声）
pnpm-lock.yaml linguist-generated=true
package-lock.json linguist-generated=true
