{
  "name": "@hope_phenom/dsh-plugin-remote-use",
  "version": "0.1.1",
  "description": "Delegate DSH tasks to a paired LAN worker and drive it like a subagent (ACP over WebSocket).",
  "license": "MIT",
  "author": "Hope.Phenom <hope.phenom@foxmail.com>",
  "homepage": "https://github.com/Hope-Phenom/dsh-plugin-remote-use#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hope-Phenom/dsh-plugin-remote-use.git",
    "directory": "packages/dsh-plugin-remote-use"
  },
  "bugs": {
    "url": "https://github.com/Hope-Phenom/dsh-plugin-remote-use/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "acp",
    "agent-client-protocol",
    "subagent",
    "remote",
    "lan",
    "gui-automation"
  ],
  "type": "module",
  "main": "lib/index.js",
  "icon": "./assets/icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "assets",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "slave/*.mjs",
    "slave/*.ps1",
    "slave/node_modules"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "ws": "8.22.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
